# ─────────────────────────────────────────────────────────────────────────────
# Production settings for docker-compose.prod.yml — copy to `.env.production` and fill in.
# Never commit .env.production. Generate each secret with the command shown above it.
# Full walkthrough (in Arabic): docs/DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# Your shop's address (its DNS A/AAAA record must point at this server before starting).
DOMAIN=shop.example.com
APP_URL=https://shop.example.com

# Database password: letters and digits only.   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs sessions and links.   openssl rand -base64 48
AUTH_SECRET=

# Opens /setup once to create the owner account. Delete it (and restart) after setup.
#   openssl rand -hex 24
SETUP_TOKEN=

# Protects the scheduled jobs called by the `cron` service.   openssl rand -hex 24
CRON_SECRET=

# ── Email (verification codes, order confirmations) ──────────────────────────
# smtp: any provider (Zoho, Google Workspace, Amazon SES, Mailgun…) · resend: resend.com
EMAIL_DRIVER=smtp
EMAIL_FROM="My Shop <no-reply@shop.example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ── Product images ───────────────────────────────────────────────────────────
# local: stored in the `media` Docker volume (included in backups)
# s3: any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO) — fill the S3_* values
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Optional protection ──────────────────────────────────────────────────────
# Cloudflare Turnstile against bots (set both or neither)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Reject passwords known from public breaches (privacy-preserving check)
PWNED_PASSWORDS_CHECK=true
# Sign in with Google (set both to enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Behind Cloudflare's proxy (orange cloud)? Follow "خلف Cloudflare" in docs/DEPLOYMENT.md: it
# fills CADDY_TRUSTED_PROXIES with Cloudflare's address ranges and sets TRUSTED_PROXY_COUNT=2.
CADDY_TRUSTED_PROXIES=
TRUSTED_PROXY_COUNT=1

LOG_LEVEL=info
# How many days of daily database backups to keep in ./backups
BACKUP_KEEP_DAYS=14
