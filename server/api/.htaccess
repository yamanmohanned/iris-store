# واجهة آيريس: الملف الوحيد المتاح من المتصفح هو index.php
Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "^(?!index\.php$).+">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(?!index\.php$).+">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
