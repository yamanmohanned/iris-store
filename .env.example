# ─────────────────────────────────────────────────────────────────────────────
# Iris Store — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the store (used in emails, auth callbacks, sitemap). https:// in production.
APP_URL=http://localhost:3000

# PostgreSQL connection (local dev: `pnpm db:local start` prints these values)
DATABASE_URL=postgres://iris:iris_dev_password@localhost:54329/iris
DATABASE_POOL_MAX=10
# Integration tests use a separate database (wiped between runs)
DATABASE_URL_TEST=postgres://iris:iris_dev_password@localhost:54329/iris_test
# Browser (E2E) tests use their own database (wiped and re-seeded on every run)
DATABASE_URL_E2E=postgres://iris:iris_dev_password@localhost:54329/iris_e2e

# Session/cookie signing secret — at least 32 random characters
AUTH_SECRET=change-me-to-a-long-random-string-of-48-characters

# One-time token required to open /setup and create the store owner (min 24 chars).
# Remove it after setup is complete.
SETUP_TOKEN=

# Protects /api/cron/* endpoints (email retries, cleanups). Min 24 chars.
CRON_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# console = print emails to the server log (development only)
# smtp    = any SMTP provider (Gmail Workspace, Zoho, Amazon SES, Mailgun, ...)
# resend  = https://resend.com HTTP API
EMAIL_DRIVER=console
EMAIL_FROM="Iris Store <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ── Media storage (product images) ───────────────────────────────────────────
# local = files on disk (VPS/Docker volume) · s3 = any S3-compatible bucket (AWS, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket/CDN, e.g. https://media.example.com
S3_PUBLIC_URL=

# ── Optional security & sign-in integrations ─────────────────────────────────
# Cloudflare Turnstile (bot protection on sign-up / sign-in / checkout) — set both or neither
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "Continue with Google" — set both to enable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reject passwords found in public breaches (calls api.pwnedpasswords.com with k-anonymity)
PWNED_PASSWORDS_CHECK=false

# ── Reverse proxy / client IP (rate limiting & audit logs) ───────────────────
# x-forwarded-for (Caddy/Nginx/Vercel) · x-real-ip · cf-connecting-ip (Cloudflare) · none
CLIENT_IP_HEADER=x-forwarded-for
# Number of trusted proxies in front of the app that append to X-Forwarded-For
TRUSTED_PROXY_COUNT=1
# Extra hosts allowed to call Server Actions (only if your proxy rewrites the Host header)
SERVER_ACTIONS_ALLOWED_ORIGINS=

LOG_LEVEL=info
# Storefront data cache (on by default). Seconds before cached catalog/settings refresh:
DATA_CACHE_TTL_SECONDS=3600
# DATA_CACHE=off   # bypass the data cache (debugging)
NEXT_TELEMETRY_DISABLED=1

# ── Design tooling (developers only) ─────────────────────────────────────────
# Stitch API key for `pnpm stitch:sync` — prefer setting it in your shell/CI secrets
STITCH_API_KEY=
